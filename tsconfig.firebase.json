{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "app/admin-panel.tsx",
    "app/auth-panel.tsx",
    "app/data.ts",
    "app/firebase-entry.tsx",
    "app/firebase.ts",
    "app/tracker.tsx",
    "firebase.vite.config.ts"
  ]
}
