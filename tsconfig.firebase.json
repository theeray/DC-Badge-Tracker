{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "app/admin-panel.tsx",
    "app/auth-panel.tsx",
    "app/availability-demo.ts",
    "app/availability-firebase.ts",
    "app/availability-scheduling.ts",
    "app/data.ts",
    "app/dc-availability.tsx",
    "app/firebase-entry.tsx",
    "app/firebase.ts",
    "app/member-development.tsx",
    "app/member-directory.tsx",
    "app/onboarding-hub.tsx",
    "app/skills-dashboard.tsx",
    "app/time-tracker.tsx",
    "app/tracker.tsx",
    "firebase.vite.config.ts"
  ]
}
