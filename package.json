{
  "name": "digital-corps-badges",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config firebase.vite.config.ts",
    "build": "npm run typecheck:firebase && npm run build:firebase",
    "build:firebase": "vite build --config firebase.vite.config.ts",
    "deploy:firebase": "npm run test && npx --yes firebase-tools@15.28.2 deploy --only firestore,hosting",
    "preview": "vite preview --config firebase.vite.config.ts",
    "test": "npm run build",
    "test:rules": "npx --yes firebase-tools@15.28.2 emulators:exec --project digital-corps-badge-tracker-rules-test --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "typecheck:firebase": "tsc --project tsconfig.firebase.json"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "Digital Corps Badge Tracker"
}
