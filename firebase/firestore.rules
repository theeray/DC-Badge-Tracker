rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function approvalPath(email) {
      return /databases/$(database)/documents/approvedUsers/$(email);
    }

    function selfReportPath(memberId, skillId) {
      return /databases/$(database)/documents/selfReportedSkills/$(memberId + '_' + skillId);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile()
        && currentUser().active == true
        && currentUser().role in ['mentee', 'mentor', 'director'];
    }

    function isMentee() {
      return activeUser() && currentUser().role == 'mentee';
    }

    function isMentor() {
      return activeUser() && currentUser().role == 'mentor';
    }

    function isDirector() {
      return activeUser() && currentUser().role == 'director';
    }

    function isStudentWorker() {
      return activeUser() && currentUser().role in ['mentee', 'mentor'];
    }

    function validTimeEntry() {
      return request.resource.data.workerId is string
        && request.resource.data.workerName is string
        && exists(userPath(request.resource.data.workerId))
        && get(userPath(request.resource.data.workerId)).data.active == true
        && get(userPath(request.resource.data.workerId)).data.role in ['mentee', 'mentor']
        && request.resource.data.startedAt is timestamp
        && (request.resource.data.endedAt == null
          || request.resource.data.endedAt is timestamp)
        && (request.resource.data.endedAt == null
          || request.resource.data.endedAt > request.resource.data.startedAt)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'workerId',
          'workerName',
          'startedAt',
          'endedAt',
          'note',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validSkillCredential() {
      return request.resource.data.workerId is string
        && request.resource.data.workerName is string
        && exists(userPath(request.resource.data.workerId))
        && get(userPath(request.resource.data.workerId)).data.active == true
        && get(userPath(request.resource.data.workerId)).data.role in ['mentee', 'mentor']
        && request.resource.data.skillId is string
        && request.resource.data.level in ['Silver', 'Gold']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.awardedBy == request.auth.uid
        && request.resource.data.awardedByName is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'workerId',
          'workerName',
          'skillId',
          'level',
          'note',
          'awardedBy',
          'awardedByName',
          'updatedAt'
        ]);
    }

    function validSkillAssignment() {
      return request.resource.data.assigneeId is string
        && request.resource.data.assigneeName is string
        && exists(userPath(request.resource.data.assigneeId))
        && get(userPath(request.resource.data.assigneeId)).data.active == true
        && get(userPath(request.resource.data.assigneeId)).data.role in ['mentee', 'mentor']
        && request.resource.data.skillId is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.status in ['assigned', 'in-progress', 'ready', 'complete']
        && request.resource.data.assignedBy is string
        && request.resource.data.assignedByName is string
        && request.resource.data.assignedByRole in ['mentor', 'director']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'assigneeId',
          'assigneeName',
          'skillId',
          'note',
          'status',
          'assignedBy',
          'assignedByName',
          'assignedByRole',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validSelfReportedSkill() {
      return request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && exists(userPath(request.resource.data.memberId))
        && get(userPath(request.resource.data.memberId)).data.active == true
        && get(userPath(request.resource.data.memberId)).data.role in ['mentee', 'mentor']
        && request.resource.data.skillId is string
        && request.resource.data.level in ['Silver', 'Gold']
        && request.resource.data.evidence is string
        && request.resource.data.evidence.size() <= 300
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'memberId',
          'memberName',
          'skillId',
          'level',
          'evidence',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validDemonstrationRequest() {
      return request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && request.resource.data.skillId is string
        && request.resource.data.mentorId == request.auth.uid
        && request.resource.data.mentorName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberId != request.auth.uid
        && exists(userPath(request.resource.data.memberId))
        && get(userPath(request.resource.data.memberId)).data.active == true
        && get(userPath(request.resource.data.memberId)).data.role in ['mentee', 'mentor']
        && request.resource.data.keys().hasOnly([
          'memberId',
          'memberName',
          'skillId',
          'mentorId',
          'mentorName',
          'createdAt'
        ]);
    }

    function validMemberProfile(memberId) {
      return request.resource.data.memberId == memberId
        && exists(userPath(memberId))
        && request.resource.data.displayName == get(userPath(memberId)).data.displayName
        && request.resource.data.email == get(userPath(memberId)).data.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.major is string
        && request.resource.data.major.size() <= 160
        && request.resource.data.graduationYear is string
        && request.resource.data.graduationYear.size() <= 40
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 120
        && request.resource.data.hasUniform is bool
        && request.resource.data.shirtSize is string
        && request.resource.data.shirtSize.size() <= 20
        && request.resource.data.preferredWeeklyHours is string
        && request.resource.data.preferredWeeklyHours.size() <= 80
        && request.resource.data.officeHours is string
        && request.resource.data.officeHours.size() <= 500
        && request.resource.data.workInterests is list
        && request.resource.data.workInterests.size() <= 30
        && request.resource.data.specialties is list
        && request.resource.data.specialties.size() <= 30
        && request.resource.data.socialMediaAreas is list
        && request.resource.data.socialMediaAreas.size() <= 30
        && request.resource.data.excitement is string
        && request.resource.data.excitement.size() <= 1000
        && request.resource.data.campaignIdeas is string
        && request.resource.data.campaignIdeas.size() <= 1000
        && request.resource.data.summerInterest in ['yes', 'no', 'maybe', 'unsure']
        && request.resource.data.websiteBlurb is string
        && request.resource.data.websiteBlurb.size() <= 1200
        && request.resource.data.professionalLink is string
        && request.resource.data.professionalLink.size() <= 500
        && request.resource.data.favoriteProject is string
        && request.resource.data.favoriteProject.size() <= 1000
        && request.resource.data.funFacts is string
        && request.resource.data.funFacts.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'memberId',
          'displayName',
          'email',
          'phone',
          'major',
          'graduationYear',
          'school',
          'hasUniform',
          'shirtSize',
          'preferredWeeklyHours',
          'officeHours',
          'workInterests',
          'specialties',
          'socialMediaAreas',
          'excitement',
          'campaignIdeas',
          'summerInterest',
          'websiteBlurb',
          'professionalLink',
          'favoriteProject',
          'funFacts',
          'createdAt',
          'updatedAt'
        ]);
    }

    function approvedForSelf() {
      return verifiedEmail()
        && exists(approvalPath(request.auth.token.email))
        && get(approvalPath(request.auth.token.email)).data.active == true;
    }

    match /approvedUsers/{email} {
      allow get: if verifiedEmail()
        && (request.auth.token.email == email || isDirector());
      allow list, create, update, delete: if isDirector();
    }

    match /users/{uid} {
      allow get: if (verifiedEmail()
          && request.auth.uid == uid
          && approvedForSelf())
        || (activeUser() && (isMentor() || isDirector()));
      allow list: if isMentor()
        || isDirector()
        || (isMentee()
          && resource.data.role == 'mentor'
          && resource.data.active == true);

      allow create: if signedIn()
        && request.auth.uid == uid
        && approvedForSelf()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.role == get(approvalPath(request.auth.token.email)).data.role
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isDirector()
        || (activeUser()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
          && request.resource.data.updatedAt == request.time);
      allow delete: if isDirector();
    }

    match /memberProfiles/{memberId} {
      allow get: if activeUser()
        && (request.auth.uid == memberId || isMentor() || isDirector());
      allow list: if isMentor() || isDirector();

      allow create: if validMemberProfile(memberId)
        && ((activeUser() && request.auth.uid == memberId)
          || isDirector());

      allow update: if validMemberProfile(memberId)
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && ((activeUser() && request.auth.uid == memberId)
          || isDirector());

      allow delete: if isDirector();
    }

    match /progress/{menteeId} {
      allow read: if activeUser()
        && (request.auth.uid == menteeId || isMentor() || isDirector());

      allow create, update: if isDirector()
        || (isStudentWorker()
          && request.auth.uid == menteeId
          && request.resource.data.ownerId == menteeId
          && request.resource.data.statuses is map
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'ownerId',
            'statuses',
            'updatedAt'
          ]));

      allow delete: if isDirector()
        || (isStudentWorker() && request.auth.uid == menteeId);
    }

    match /progressBackups/{menteeId} {
      allow read, create, update, delete: if isDirector();
    }

    match /endorsements/{endorsementId} {
      allow read: if activeUser()
        && (request.auth.uid == resource.data.menteeId
          || isMentor()
          || isDirector()
          || (isMentee()
            && exists(userPath(resource.data.menteeId))
            && get(userPath(resource.data.menteeId)).data.active == true
            && get(userPath(resource.data.menteeId)).data.role == 'mentor'));

      allow create: if isMentor()
        && request.resource.data.mentorId == request.auth.uid
        && request.resource.data.mentorName is string
        && request.resource.data.menteeId is string
        && request.resource.data.skillId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'menteeId',
          'skillId',
          'mentorId',
          'mentorName',
          'createdAt'
        ])
        && request.resource.data.menteeId != request.auth.uid
        && exists(userPath(request.resource.data.menteeId))
        && get(userPath(request.resource.data.menteeId)).data.active == true
        && get(userPath(request.resource.data.menteeId)).data.role in ['mentee', 'mentor']
        && ((exists(/databases/$(database)/documents/progress/$(request.resource.data.menteeId))
            && get(/databases/$(database)/documents/progress/$(request.resource.data.menteeId))
              .data.statuses[request.resource.data.skillId] in ['ready', 'complete'])
          || exists(selfReportPath(
            request.resource.data.menteeId,
            request.resource.data.skillId
          )));

      allow update: if false;
      allow delete: if isDirector()
        || (isMentor() && resource.data.mentorId == request.auth.uid);
    }

    match /timeEntries/{entryId} {
      allow read: if activeUser()
        && (isDirector() || resource.data.workerId == request.auth.uid);

      allow create: if (isDirector()
          || (isStudentWorker()
            && request.resource.data.workerId == request.auth.uid))
        && validTimeEntry()
        && request.resource.data.createdAt == request.time;

      allow update: if (isDirector()
          || (isStudentWorker()
            && resource.data.workerId == request.auth.uid
            && request.resource.data.workerId == resource.data.workerId))
        && validTimeEntry()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.workerName == resource.data.workerName;

      allow delete: if isDirector()
        || (isStudentWorker() && resource.data.workerId == request.auth.uid);
    }

    match /skillCredentials/{credentialId} {
      allow read: if activeUser()
        && (isMentor()
          || isDirector()
          || resource.data.workerId == request.auth.uid
          || (isMentee()
            && exists(userPath(resource.data.workerId))
            && get(userPath(resource.data.workerId)).data.active == true
            && get(userPath(resource.data.workerId)).data.role == 'mentor'));
      allow create, update: if isDirector() && validSkillCredential();
      allow delete: if isDirector();
    }

    match /skillAssignments/{assignmentId} {
      allow read: if activeUser()
        && (isMentor()
          || isDirector()
          || resource.data.assigneeId == request.auth.uid);

      allow create: if (isMentor() || isDirector())
        && validSkillAssignment()
        && request.resource.data.createdAt == request.time
        && ((isMentor()
            && request.resource.data.assignedBy == request.auth.uid
            && request.resource.data.assignedByRole == 'mentor')
          || (isDirector()
            && ((request.resource.data.assignedBy == request.auth.uid
                && request.resource.data.assignedByRole == 'director')
              || (exists(userPath(request.resource.data.assignedBy))
                && get(userPath(request.resource.data.assignedBy)).data.role
                  == request.resource.data.assignedByRole
                && request.resource.data.assignedByRole in ['mentor', 'director']))));

      allow update: if validSkillAssignment()
        && request.resource.data.assigneeId == resource.data.assigneeId
        && request.resource.data.assigneeName == resource.data.assigneeName
        && request.resource.data.skillId == resource.data.skillId
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.assignedByName == resource.data.assignedByName
        && request.resource.data.assignedByRole == resource.data.assignedByRole
        && request.resource.data.createdAt == resource.data.createdAt
        && (isDirector()
          || (isMentor()
            && resource.data.assignedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['note', 'updatedAt']))
          || (isStudentWorker()
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])));

      allow delete: if isDirector()
        || (isMentor() && resource.data.assignedBy == request.auth.uid);
    }

    match /selfReportedSkills/{reportId} {
      allow read: if activeUser()
        && (isMentor()
          || isDirector()
          || resource.data.memberId == request.auth.uid
          || (isMentee()
            && exists(userPath(resource.data.memberId))
            && get(userPath(resource.data.memberId)).data.active == true
            && get(userPath(resource.data.memberId)).data.role == 'mentor'));

      allow create: if validSelfReportedSkill()
        && request.resource.data.createdAt == request.time
        && ((isStudentWorker()
            && request.resource.data.memberId == request.auth.uid)
          || isDirector());

      allow update: if validSelfReportedSkill()
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.memberName == resource.data.memberName
        && request.resource.data.skillId == resource.data.skillId
        && request.resource.data.createdAt == resource.data.createdAt
        && (isDirector()
          || (isStudentWorker()
            && resource.data.memberId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['level', 'evidence', 'updatedAt'])));

      allow delete: if isDirector()
        || (isStudentWorker() && resource.data.memberId == request.auth.uid);
    }

    match /demonstrationRequests/{requestId} {
      allow read: if activeUser()
        && (isDirector()
          || resource.data.memberId == request.auth.uid
          || (isMentor() && resource.data.mentorId == request.auth.uid));

      allow create: if isMentor() && validDemonstrationRequest();
      allow update: if false;
      allow delete: if isDirector()
        || (isMentor() && resource.data.mentorId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
