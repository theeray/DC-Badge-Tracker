rules_version = '2';

// Knowledge checks (all new records are immutable; corrections use a new version
// or review revision, never overwrite a previous answer or grading decision):
// knowledgeBanks/{bankId}_v{version}: bankId slug<=80, version int1..1000,
//   title<=160, skillIds1..10 strings<=100, sourceUrl HTTPS<=1000, scope<=1600,
//   questions {q1..q4:{prompt<=1000,topic<=100}}, createdBy UID, createdAt timestamp.
// knowledgeGuides/{bankKey}: bankId,version, questions {q1..q4:{expectedAnswer<=3000,
//   explanation<=2000,studentFeedback<=1000,practiceTask<=1500}},createdBy,createdAt.
//   Private to verified active mentors/directors; never mixed into learner docs.
// knowledgeAttempts/{ownerUid}/submissions/{attemptId}: ownerId,ownerRole snapshot,
//   bankKey,bankId,version,skillId,answers{q1..q4:nonblank<=2000},createdAt.
// .../reviews/{reviewId}: reviewerId,reviewerName<=160,verdicts{q1..q4:enum},
//   feedback{q1..q4:string<=1000},practiceTasks{q1..q4:string<=1500},summary<=1500,
//   score0..4 matching verdict count,createdAt,status graded|voided,reason<=500.
// These paths intentionally add no permissions to existing account/progress docs.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function approvalPath(email) {
      return /databases/$(database)/documents/approvedUsers/$(email);
    }

    function selfReportPath(memberId, skillId) {
      return /databases/$(database)/documents/selfReportedSkills/$(memberId + '_' + skillId);
    }

    function availabilityPollPath(pollId) {
      return /databases/$(database)/documents/availabilityPolls/$(pollId);
    }

    function availabilityPollData(pollId) {
      return get(availabilityPollPath(pollId)).data;
    }

    function nonblank(value, maximum) {
      return value is string
        && value.size() > 0
        && value.size() <= maximum
        && value.matches('.*\\S.*');
    }

    function validAvailabilityPoll() {
      return request.resource.data.keys().hasOnly([
          'title',
          'description',
          'organizerName',
          'ownerUid',
          'timezone',
          'duration',
          'slotIds',
          'status',
          'selectedStart',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'title',
          'description',
          'organizerName',
          'ownerUid',
          'timezone',
          'duration',
          'slotIds',
          'status',
          'selectedStart',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.organizerName == currentUser().displayName
        && nonblank(request.resource.data.title, 100)
        && nonblank(request.resource.data.organizerName, 60)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && nonblank(request.resource.data.timezone, 80)
        && request.resource.data.duration in [30, 60, 90, 120]
        && request.resource.data.slotIds is list
        && request.resource.data.slotIds.size() > 0
        && request.resource.data.slotIds.size() <= 672
        && request.resource.data.slotIds.toSet().size()
          == request.resource.data.slotIds.size()
        && request.resource.data.status == 'open'
        && request.resource.data.selectedStart == ''
        && request.resource.data.schemaVersion in [1, 2]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAvailabilityResponse(pollId) {
      return request.resource.data.keys().hasOnly([
          'name',
          'available',
          'ifNeeded',
          'participantType',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'available',
          'ifNeeded',
          'updatedAt'
        ])
        && nonblank(request.resource.data.name, 60)
        && (!request.resource.data.keys().hasAny(['participantType'])
          || request.resource.data.participantType in ['member', 'guest'])
        && request.resource.data.available is list
        && request.resource.data.ifNeeded is list
        && request.resource.data.available.size() <= 672
        && request.resource.data.ifNeeded.size() <= 672
        && request.resource.data.available.toSet().size()
          == request.resource.data.available.size()
        && request.resource.data.ifNeeded.toSet().size()
          == request.resource.data.ifNeeded.size()
        && request.resource.data.available.hasOnly(
          availabilityPollData(pollId).slotIds
        )
        && request.resource.data.ifNeeded.hasOnly(
          availabilityPollData(pollId).slotIds
        )
        && !request.resource.data.available.hasAny(
          request.resource.data.ifNeeded
        )
        && request.resource.data.updatedAt == request.time;
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile()
        && currentUser().active == true
        && currentUser().role in ['mentee', 'mentor', 'director'];
    }

    function isMentee() {
      return activeUser() && currentUser().role == 'mentee';
    }

    function isMentor() {
      return activeUser() && currentUser().role == 'mentor';
    }

    function isDirector() {
      return activeUser() && currentUser().role == 'director';
    }

    function isStudentWorker() {
      return activeUser() && currentUser().role in ['mentee', 'mentor'];
    }

    function knowledgeMember() {
      return verifiedEmail() && activeUser();
    }

    function knowledgeBankPath(bankKey) {
      return /databases/$(database)/documents/knowledgeBanks/$(bankKey);
    }

    function knowledgeAttemptPath(ownerUid, attemptId) {
      return /databases/$(database)/documents/knowledgeAttempts/$(ownerUid)/submissions/$(attemptId);
    }

    function knowledgeString(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function knowledgeNonblank(value, maximum) {
      return knowledgeString(value, maximum) && value.size() > 0
        && value.matches('(?s).*\\S.*');
    }

    function knowledgeFourKeys(value) {
      return value is map && value.keys().hasAll(['q1', 'q2', 'q3', 'q4'])
        && value.keys().hasOnly(['q1', 'q2', 'q3', 'q4']);
    }

    function knowledgeQuestion(value) {
      return value is map && value.keys().hasAll(['prompt', 'topic'])
        && value.keys().hasOnly(['prompt', 'topic'])
        && knowledgeNonblank(value.prompt, 1000) && knowledgeNonblank(value.topic, 100);
    }

    function knowledgeGuideQuestion(value) {
      return value is map
        && value.keys().hasAll(['expectedAnswer', 'explanation', 'studentFeedback', 'practiceTask'])
        && value.keys().hasOnly(['expectedAnswer', 'explanation', 'studentFeedback', 'practiceTask'])
        && knowledgeNonblank(value.expectedAnswer, 3000)
        && knowledgeNonblank(value.explanation, 2000)
        && knowledgeNonblank(value.studentFeedback, 1000)
        && knowledgeNonblank(value.practiceTask, 1500);
    }

    function knowledgeSkillIds(value) {
      return value is list && value.size() > 0 && value.size() <= 10
        && value.toSet().size() == value.size()
        && knowledgeNonblank(value[0], 100)
        && (value.size() < 2 || knowledgeNonblank(value[1], 100))
        && (value.size() < 3 || knowledgeNonblank(value[2], 100))
        && (value.size() < 4 || knowledgeNonblank(value[3], 100))
        && (value.size() < 5 || knowledgeNonblank(value[4], 100))
        && (value.size() < 6 || knowledgeNonblank(value[5], 100))
        && (value.size() < 7 || knowledgeNonblank(value[6], 100))
        && (value.size() < 8 || knowledgeNonblank(value[7], 100))
        && (value.size() < 9 || knowledgeNonblank(value[8], 100))
        && (value.size() < 10 || knowledgeNonblank(value[9], 100));
    }

    function knowledgeBankIdentity(data, bankKey) {
      return knowledgeNonblank(data.bankId, 80)
        && data.bankId.matches('[a-z0-9]+(-[a-z0-9]+)*')
        && data.version is int && data.version >= 1 && data.version <= 1000
        && bankKey == data.bankId + '_v' + string(data.version);
    }

    function validKnowledgeBank(bankKey) {
      let data = request.resource.data;
      return data.keys().hasAll(['bankId', 'version', 'title', 'skillIds', 'sourceUrl', 'scope', 'questions', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['bankId', 'version', 'title', 'skillIds', 'sourceUrl', 'scope', 'questions', 'createdBy', 'createdAt'])
        && knowledgeBankIdentity(data, bankKey)
        && knowledgeNonblank(data.title, 160) && knowledgeSkillIds(data.skillIds)
        && knowledgeNonblank(data.sourceUrl, 1000) && data.sourceUrl.matches('https://.*')
        && knowledgeNonblank(data.scope, 1600) && knowledgeFourKeys(data.questions)
        && knowledgeQuestion(data.questions.q1) && knowledgeQuestion(data.questions.q2)
        && knowledgeQuestion(data.questions.q3) && knowledgeQuestion(data.questions.q4)
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function validKnowledgeGuide(bankKey) {
      let data = request.resource.data;
      let bank = getAfter(knowledgeBankPath(bankKey)).data;
      return data.keys().hasAll(['bankId', 'version', 'questions', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['bankId', 'version', 'questions', 'createdBy', 'createdAt'])
        && knowledgeBankIdentity(data, bankKey)
        && bank.bankId == data.bankId && bank.version == data.version
        && knowledgeFourKeys(data.questions)
        && knowledgeGuideQuestion(data.questions.q1) && knowledgeGuideQuestion(data.questions.q2)
        && knowledgeGuideQuestion(data.questions.q3) && knowledgeGuideQuestion(data.questions.q4)
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function knowledgeCanReadOwner(ownerUid) {
      let role = currentUser().role;
      return knowledgeMember()
        && (request.auth.uid == ownerUid || role == 'director'
          || (role == 'mentor' && exists(userPath(ownerUid))
            && get(userPath(ownerUid)).data.active == true
            && get(userPath(ownerUid)).data.role == 'mentee'));
    }

    function knowledgeCanReviewOwner(ownerUid) {
      let role = currentUser().role;
      return knowledgeMember()
        && (role == 'director'
          || (role == 'mentor' && request.auth.uid != ownerUid
            && exists(userPath(ownerUid))
            && get(userPath(ownerUid)).data.active == true
            && get(userPath(ownerUid)).data.role == 'mentee'));
    }

    function validKnowledgeAttempt(ownerUid) {
      let data = request.resource.data;
      let bank = get(knowledgeBankPath(data.bankKey)).data;
      return data.keys().hasAll(['ownerId', 'ownerRole', 'bankKey', 'bankId', 'version', 'skillId', 'answers', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'ownerRole', 'bankKey', 'bankId', 'version', 'skillId', 'answers', 'createdAt'])
        && data.ownerId == ownerUid && data.ownerId == request.auth.uid
        && data.ownerRole == currentUser().role
        && knowledgeString(data.bankKey, 90) && knowledgeBankIdentity(data, data.bankKey)
        && bank.bankId == data.bankId && bank.version == data.version
        && exists(/databases/$(database)/documents/knowledgeGuides/$(data.bankKey))
        && knowledgeNonblank(data.skillId, 100) && data.skillId in bank.skillIds
        && knowledgeFourKeys(data.answers)
        && knowledgeNonblank(data.answers.q1, 2000) && knowledgeNonblank(data.answers.q2, 2000)
        && knowledgeNonblank(data.answers.q3, 2000) && knowledgeNonblank(data.answers.q4, 2000)
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function knowledgeVerdicts(value) {
      return knowledgeFourKeys(value)
        && value.q1 in ['correct', 'incorrect'] && value.q2 in ['correct', 'incorrect']
        && value.q3 in ['correct', 'incorrect'] && value.q4 in ['correct', 'incorrect'];
    }

    function knowledgeTextMap(value, maximum) {
      return knowledgeFourKeys(value)
        && knowledgeString(value.q1, maximum) && knowledgeString(value.q2, maximum)
        && knowledgeString(value.q3, maximum) && knowledgeString(value.q4, maximum);
    }

    function knowledgePracticeFeedback(verdict, feedback, task) {
      // Types and maximum lengths have already been checked by knowledgeTextMap.
      return verdict == 'correct'
        || (feedback.matches('(?s).*\\S.*') && task.matches('(?s).*\\S.*'));
    }

    function validKnowledgeReview(ownerUid, attemptId) {
      let data = request.resource.data;
      let attempt = get(knowledgeAttemptPath(ownerUid, attemptId)).data;
      return data.keys().hasAll(['reviewerId', 'reviewerName', 'verdicts', 'feedback', 'practiceTasks', 'summary', 'score', 'createdAt', 'status', 'reason'])
        && data.keys().hasOnly(['reviewerId', 'reviewerName', 'verdicts', 'feedback', 'practiceTasks', 'summary', 'score', 'createdAt', 'status', 'reason'])
        && data.reviewerId == request.auth.uid
        && data.reviewerName == currentUser().displayName && knowledgeNonblank(data.reviewerName, 160)
        && knowledgeVerdicts(data.verdicts)
        && knowledgeTextMap(data.feedback, 1000) && knowledgeTextMap(data.practiceTasks, 1500)
        && knowledgeString(data.summary, 1500) && knowledgeString(data.reason, 500)
        && data.score is int && data.score >= 0 && data.score <= 4
        && data.score == ((data.verdicts.q1 == 'correct' ? 1 : 0)
          + (data.verdicts.q2 == 'correct' ? 1 : 0)
          + (data.verdicts.q3 == 'correct' ? 1 : 0)
          + (data.verdicts.q4 == 'correct' ? 1 : 0))
        && data.status in ['graded', 'voided']
        && (data.status == 'graded'
          || (currentUser().role == 'director' && data.score == 0 && knowledgeNonblank(data.reason, 500)))
        && (data.status == 'voided'
          || (knowledgePracticeFeedback(data.verdicts.q1, data.feedback.q1, data.practiceTasks.q1)
            && knowledgePracticeFeedback(data.verdicts.q2, data.feedback.q2, data.practiceTasks.q2)
            && knowledgePracticeFeedback(data.verdicts.q3, data.feedback.q3, data.practiceTasks.q3)
            && knowledgePracticeFeedback(data.verdicts.q4, data.feedback.q4, data.practiceTasks.q4)))
        && exists(/databases/$(database)/documents/knowledgeGuides/$(attempt.bankKey))
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function validTimeEntry() {
      return request.resource.data.workerId is string
        && request.resource.data.workerName is string
        && exists(userPath(request.resource.data.workerId))
        && get(userPath(request.resource.data.workerId)).data.active == true
        && get(userPath(request.resource.data.workerId)).data.role in ['mentee', 'mentor']
        && request.resource.data.startedAt is timestamp
        && (request.resource.data.endedAt == null
          || request.resource.data.endedAt is timestamp)
        && (request.resource.data.endedAt == null
          || request.resource.data.endedAt > request.resource.data.startedAt)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'workerId',
          'workerName',
          'startedAt',
          'endedAt',
          'note',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validSkillCredential() {
      return request.resource.data.workerId is string
        && request.resource.data.workerName is string
        && exists(userPath(request.resource.data.workerId))
        && get(userPath(request.resource.data.workerId)).data.active == true
        && get(userPath(request.resource.data.workerId)).data.role in ['mentee', 'mentor']
        && request.resource.data.skillId is string
        && request.resource.data.level in ['Silver', 'Gold']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.awardedBy == request.auth.uid
        && request.resource.data.awardedByName is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'workerId',
          'workerName',
          'skillId',
          'level',
          'note',
          'awardedBy',
          'awardedByName',
          'updatedAt'
        ]);
    }

    function validSkillAssignment() {
      return request.resource.data.assigneeId is string
        && request.resource.data.assigneeName is string
        && exists(userPath(request.resource.data.assigneeId))
        && get(userPath(request.resource.data.assigneeId)).data.active == true
        && get(userPath(request.resource.data.assigneeId)).data.role in ['mentee', 'mentor']
        && request.resource.data.skillId is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 160
        && request.resource.data.status in ['assigned', 'in-progress', 'ready', 'complete']
        && request.resource.data.assignedBy is string
        && request.resource.data.assignedByName is string
        && request.resource.data.assignedByRole in ['mentor', 'director']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'assigneeId',
          'assigneeName',
          'skillId',
          'note',
          'status',
          'assignedBy',
          'assignedByName',
          'assignedByRole',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validSelfReportedSkill() {
      return request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && exists(userPath(request.resource.data.memberId))
        && get(userPath(request.resource.data.memberId)).data.active == true
        && get(userPath(request.resource.data.memberId)).data.role in ['mentee', 'mentor', 'director']
        && request.resource.data.skillId is string
        && request.resource.data.level in ['Silver', 'Gold']
        && request.resource.data.evidence is string
        && request.resource.data.evidence.size() <= 300
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'memberId',
          'memberName',
          'skillId',
          'level',
          'evidence',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validDemonstrationRequest() {
      return request.resource.data.memberId is string
        && request.resource.data.memberName is string
        && request.resource.data.skillId is string
        && request.resource.data.mentorId == request.auth.uid
        && request.resource.data.mentorName is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberId != request.auth.uid
        && exists(userPath(request.resource.data.memberId))
        && get(userPath(request.resource.data.memberId)).data.active == true
        && get(userPath(request.resource.data.memberId)).data.role in ['mentee', 'mentor']
        && request.resource.data.keys().hasOnly([
          'memberId',
          'memberName',
          'skillId',
          'mentorId',
          'mentorName',
          'createdAt'
        ]);
    }

    function validMemberProfile(memberId) {
      return request.resource.data.memberId == memberId
        && exists(userPath(memberId))
        && request.resource.data.displayName == get(userPath(memberId)).data.displayName
        && request.resource.data.email == get(userPath(memberId)).data.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.major is string
        && request.resource.data.major.size() <= 160
        && request.resource.data.graduationYear is string
        && request.resource.data.graduationYear.size() <= 40
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 120
        && request.resource.data.hasUniform is bool
        && request.resource.data.shirtSize is string
        && request.resource.data.shirtSize.size() <= 20
        && request.resource.data.preferredWeeklyHours is string
        && request.resource.data.preferredWeeklyHours.size() <= 80
        && request.resource.data.officeHours is string
        && request.resource.data.officeHours.size() <= 500
        && request.resource.data.workInterests is list
        && request.resource.data.workInterests.size() <= 30
        && request.resource.data.specialties is list
        && request.resource.data.specialties.size() <= 30
        && request.resource.data.socialMediaAreas is list
        && request.resource.data.socialMediaAreas.size() <= 30
        && request.resource.data.excitement is string
        && request.resource.data.excitement.size() <= 1000
        && request.resource.data.campaignIdeas is string
        && request.resource.data.campaignIdeas.size() <= 1000
        && request.resource.data.summerInterest in ['yes', 'no', 'maybe', 'unsure']
        && request.resource.data.websiteBlurb is string
        && request.resource.data.websiteBlurb.size() <= 1200
        && request.resource.data.professionalLink is string
        && request.resource.data.professionalLink.size() <= 500
        && request.resource.data.favoriteProject is string
        && request.resource.data.favoriteProject.size() <= 1000
        && request.resource.data.funFacts is string
        && request.resource.data.funFacts.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'memberId',
          'displayName',
          'email',
          'phone',
          'major',
          'graduationYear',
          'school',
          'hasUniform',
          'shirtSize',
          'preferredWeeklyHours',
          'officeHours',
          'workInterests',
          'specialties',
          'socialMediaAreas',
          'excitement',
          'campaignIdeas',
          'summerInterest',
          'websiteBlurb',
          'professionalLink',
          'favoriteProject',
          'funFacts',
          'createdAt',
          'updatedAt'
        ]);
    }

    function approvedForSelf() {
      return verifiedEmail()
        && exists(approvalPath(request.auth.token.email))
        && get(approvalPath(request.auth.token.email)).data.active == true;
    }

    match /approvedUsers/{email} {
      allow get: if verifiedEmail()
        && (request.auth.token.email == email || isDirector());
      allow list, create, update, delete: if isDirector();
    }

    match /users/{uid} {
      allow get: if (verifiedEmail()
          && request.auth.uid == uid
          && approvedForSelf())
        || (activeUser() && (isMentor() || isDirector()));
      allow list: if isMentor()
        || isDirector()
        || (isMentee()
          && resource.data.role == 'mentor'
          && resource.data.active == true);

      allow create: if signedIn()
        && request.auth.uid == uid
        && approvedForSelf()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.role == get(approvalPath(request.auth.token.email)).data.role
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'displayName',
          'email',
          'role',
          'active',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isDirector()
        || (activeUser()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt'])
          && request.resource.data.updatedAt == request.time);
      allow delete: if isDirector();
    }

    match /memberProfiles/{memberId} {
      allow get: if activeUser()
        && (request.auth.uid == memberId || isMentor() || isDirector());
      allow list: if isMentor() || isDirector();

      allow create: if validMemberProfile(memberId)
        && ((activeUser() && request.auth.uid == memberId)
          || isDirector());

      allow update: if validMemberProfile(memberId)
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && ((activeUser() && request.auth.uid == memberId)
          || isDirector());

      allow delete: if isDirector();
    }

    match /progress/{menteeId} {
      allow read: if activeUser()
        && (request.auth.uid == menteeId
          || isDirector()
          || (isMentor()
            && exists(userPath(menteeId))
            && get(userPath(menteeId)).data.active == true
            && get(userPath(menteeId)).data.role in ['mentee', 'mentor']));

      allow create, update: if isDirector()
        || (isStudentWorker()
          && request.auth.uid == menteeId
          && request.resource.data.ownerId == menteeId
          && request.resource.data.statuses is map
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'ownerId',
            'statuses',
            'updatedAt'
          ]));

      allow delete: if isDirector()
        || (isStudentWorker() && request.auth.uid == menteeId);
    }

    match /progressBackups/{menteeId} {
      allow read, create, update, delete: if isDirector();
    }

    match /endorsements/{endorsementId} {
      allow read: if activeUser()
        && (request.auth.uid == resource.data.menteeId
          || isMentor()
          || isDirector()
          || (isMentee()
            && exists(userPath(resource.data.menteeId))
            && get(userPath(resource.data.menteeId)).data.active == true
            && get(userPath(resource.data.menteeId)).data.role == 'mentor'));

      allow create: if isMentor()
        && request.resource.data.mentorId == request.auth.uid
        && request.resource.data.mentorName is string
        && request.resource.data.menteeId is string
        && request.resource.data.skillId is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'menteeId',
          'skillId',
          'mentorId',
          'mentorName',
          'createdAt'
        ])
        && request.resource.data.menteeId != request.auth.uid
        && exists(userPath(request.resource.data.menteeId))
        && get(userPath(request.resource.data.menteeId)).data.active == true
        && get(userPath(request.resource.data.menteeId)).data.role in ['mentee', 'mentor']
        && ((exists(/databases/$(database)/documents/progress/$(request.resource.data.menteeId))
            && get(/databases/$(database)/documents/progress/$(request.resource.data.menteeId))
              .data.statuses[request.resource.data.skillId] in ['ready', 'complete'])
          || exists(selfReportPath(
            request.resource.data.menteeId,
            request.resource.data.skillId
          )));

      allow update: if false;
      allow delete: if isDirector()
        || (isMentor() && resource.data.mentorId == request.auth.uid);
    }

    match /timeEntries/{entryId} {
      allow read: if activeUser()
        && (isDirector() || resource.data.workerId == request.auth.uid);

      allow create: if (isDirector()
          || (isStudentWorker()
            && request.resource.data.workerId == request.auth.uid))
        && validTimeEntry()
        && request.resource.data.createdAt == request.time;

      allow update: if (isDirector()
          || (isStudentWorker()
            && resource.data.workerId == request.auth.uid
            && request.resource.data.workerId == resource.data.workerId))
        && validTimeEntry()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.workerName == resource.data.workerName;

      allow delete: if isDirector()
        || (isStudentWorker() && resource.data.workerId == request.auth.uid);
    }

    match /skillCredentials/{credentialId} {
      allow read: if activeUser()
        && (isDirector()
          || resource.data.workerId == request.auth.uid
          || (isMentor()
            && exists(userPath(resource.data.workerId))
            && get(userPath(resource.data.workerId)).data.active == true
            && get(userPath(resource.data.workerId)).data.role in ['mentee', 'mentor'])
          || (isMentee()
            && exists(userPath(resource.data.workerId))
            && get(userPath(resource.data.workerId)).data.active == true
            && get(userPath(resource.data.workerId)).data.role == 'mentor'));
      allow create, update: if isDirector() && validSkillCredential();
      allow delete: if isDirector();
    }

    match /skillAssignments/{assignmentId} {
      allow read: if activeUser()
        && (isMentor()
          || isDirector()
          || resource.data.assigneeId == request.auth.uid);

      allow create: if (isMentor() || isDirector())
        && validSkillAssignment()
        && request.resource.data.createdAt == request.time
        && ((isMentor()
            && request.resource.data.assignedBy == request.auth.uid
            && request.resource.data.assignedByRole == 'mentor')
          || (isDirector()
            && ((request.resource.data.assignedBy == request.auth.uid
                && request.resource.data.assignedByRole == 'director')
              || (exists(userPath(request.resource.data.assignedBy))
                && get(userPath(request.resource.data.assignedBy)).data.role
                  == request.resource.data.assignedByRole
                && request.resource.data.assignedByRole in ['mentor', 'director']))));

      allow update: if validSkillAssignment()
        && request.resource.data.assigneeId == resource.data.assigneeId
        && request.resource.data.assigneeName == resource.data.assigneeName
        && request.resource.data.skillId == resource.data.skillId
        && request.resource.data.assignedBy == resource.data.assignedBy
        && request.resource.data.assignedByName == resource.data.assignedByName
        && request.resource.data.assignedByRole == resource.data.assignedByRole
        && request.resource.data.createdAt == resource.data.createdAt
        && (isDirector()
          || (isMentor()
            && resource.data.assignedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['note', 'updatedAt']))
          || (isStudentWorker()
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])));

      allow delete: if isDirector()
        || (isMentor() && resource.data.assignedBy == request.auth.uid);
    }

    match /selfReportedSkills/{reportId} {
      allow read: if activeUser()
        && (isDirector()
          || resource.data.memberId == request.auth.uid
          || (isMentor()
            && exists(userPath(resource.data.memberId))
            && get(userPath(resource.data.memberId)).data.active == true
            && get(userPath(resource.data.memberId)).data.role in ['mentee', 'mentor'])
          || (isMentee()
            && exists(userPath(resource.data.memberId))
            && get(userPath(resource.data.memberId)).data.active == true
            && get(userPath(resource.data.memberId)).data.role == 'mentor'));

      allow create: if validSelfReportedSkill()
        && request.resource.data.createdAt == request.time
        && ((isStudentWorker()
            && request.resource.data.memberId == request.auth.uid)
          || isDirector());

      allow update: if validSelfReportedSkill()
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.memberName == resource.data.memberName
        && request.resource.data.skillId == resource.data.skillId
        && request.resource.data.createdAt == resource.data.createdAt
        && (isDirector()
          || (isStudentWorker()
            && resource.data.memberId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['level', 'evidence', 'updatedAt'])));

      allow delete: if isDirector()
        || (isStudentWorker() && resource.data.memberId == request.auth.uid);
    }

    match /demonstrationRequests/{requestId} {
      allow read: if activeUser()
        && (isDirector()
          || resource.data.memberId == request.auth.uid
          || (isMentor() && resource.data.mentorId == request.auth.uid));

      allow create: if isMentor() && validDemonstrationRequest();
      allow update: if false;
      allow delete: if isDirector()
        || (isMentor() && resource.data.mentorId == request.auth.uid);
    }

    match /knowledgeBanks/{bankKey} {
      allow read: if knowledgeMember();
      allow create: if knowledgeMember() && currentUser().role == 'director' && validKnowledgeBank(bankKey);
      allow update, delete: if false;
    }

    match /knowledgeGuides/{bankKey} {
      allow read: if knowledgeMember() && currentUser().role in ['mentor', 'director'];
      allow create: if knowledgeMember() && currentUser().role == 'director' && validKnowledgeGuide(bankKey);
      allow update, delete: if false;
    }

    match /knowledgeAttempts/{ownerUid}/submissions/{attemptId} {
      allow read: if knowledgeCanReadOwner(ownerUid)
        && (request.auth.uid == ownerUid || currentUser().role == 'director'
          || resource.data.ownerRole == 'mentee');
      allow create: if knowledgeMember() && request.auth.uid == ownerUid
        && attemptId.matches('[A-Za-z0-9_-]{1,100}')
        && validKnowledgeAttempt(ownerUid);
      allow update, delete: if false;

      match /reviews/{reviewId} {
        allow read: if knowledgeCanReadOwner(ownerUid)
          && exists(knowledgeAttemptPath(ownerUid, attemptId))
          && (request.auth.uid == ownerUid || currentUser().role == 'director'
            || get(knowledgeAttemptPath(ownerUid, attemptId)).data.ownerRole == 'mentee');
        allow create: if knowledgeCanReviewOwner(ownerUid)
          && reviewId.matches('[A-Za-z0-9_-]{1,100}')
          && exists(knowledgeAttemptPath(ownerUid, attemptId))
          && (currentUser().role == 'director'
            || get(knowledgeAttemptPath(ownerUid, attemptId)).data.ownerRole == 'mentee')
          && validKnowledgeReview(ownerUid, attemptId);
        allow update, delete: if false;
      }
    }

    match /availabilityPolls/{pollId} {
      // Poll IDs are unguessable invitation links. There is no public list.
      allow get: if true;
      allow list: if false;

      allow create: if activeUser() && validAvailabilityPoll();

      allow update: if activeUser()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.organizerName == resource.data.organizerName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'status',
          'selectedStart',
          'updatedAt'
        ])
        && nonblank(request.resource.data.title, 100)
        && ((request.resource.data.status == 'open'
            && request.resource.data.selectedStart == '')
          || (request.resource.data.status == 'closed'
            && request.resource.data.selectedStart in resource.data.slotIds));

      allow delete: if false;

      match /responses/{uid} {
        allow read: if exists(availabilityPollPath(pollId));

        allow create, update: if (
            (activeUser()
              && request.auth.uid == uid
              && request.resource.data.name == currentUser().displayName
              && (!request.resource.data.keys().hasAny(['participantType'])
                || request.resource.data.participantType == 'member'))
            || (!signedIn()
              && uid.matches('guest_[a-f0-9]{32}')
              && request.resource.data.participantType == 'guest')
          )
          && availabilityPollData(pollId).status == 'open'
          && validAvailabilityResponse(pollId);

        allow delete: if false;
      }

      // A copied response is an immutable starting point, not confirmation.
      match /copiedResponses/{uid} {
        allow read: if exists(availabilityPollPath(pollId));

        allow create: if activeUser()
          && !exists(availabilityPollPath(pollId))
          && getAfter(availabilityPollPath(pollId)).data.ownerUid
            == request.auth.uid
          && getAfter(availabilityPollPath(pollId)).data.schemaVersion == 2
          && request.resource.data.keys().hasOnly([
            'name',
            'available',
            'ifNeeded',
            'participantType',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'name',
            'available',
            'ifNeeded',
            'updatedAt'
          ])
          && nonblank(request.resource.data.name, 60)
          && (!request.resource.data.keys().hasAny(['participantType'])
            || request.resource.data.participantType in ['member', 'guest'])
          && request.resource.data.available is list
          && request.resource.data.ifNeeded is list
          && request.resource.data.available.size() <= 672
          && request.resource.data.ifNeeded.size() <= 672
          && request.resource.data.available.toSet().size()
            == request.resource.data.available.size()
          && request.resource.data.ifNeeded.toSet().size()
            == request.resource.data.ifNeeded.size()
          && request.resource.data.available.hasOnly(
            getAfter(availabilityPollPath(pollId)).data.slotIds
          )
          && request.resource.data.ifNeeded.hasOnly(
            getAfter(availabilityPollPath(pollId)).data.slotIds
          )
          && !request.resource.data.available.hasAny(
            request.resource.data.ifNeeded
          )
          && request.resource.data.updatedAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
