{
  "hosting": {
    "target": "short",
    "public": "firebase-redirect",
    "ignore": [
      "firebase.short-hosting.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "**",
        "destination": "https://dc-central.web.app/",
        "type": 301
      }
    ]
  }
}
